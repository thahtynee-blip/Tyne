// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id           Int    @id
  name         String
  category     String
  categoryName String
  price        Float
  image        String
  description  String
  rating       Float
  reviewsCount Int
  specs        Json
}

model Order {
  id           String   @id @default(uuid())
  date         String
  products     String
  total        Float
  status       String   @default("processing")
  statusName   String   @default("Đang xử lý")
  userEmail    String
  shippingInfo Json
  items        Json
  createdAt    DateTime @default(now())
}

model Profile {
  id        String   @id
  email     String   @unique
  name      String?
  phone     String?
  address   String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}
